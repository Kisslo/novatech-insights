# Template for local environment configuration.
# Copy to .env and replace the placeholders with actual values.
# Never include real API keys, passwords, or customer data.

# Supabase API connection.
# Project base URL, without /rest/v1.
SUPABASE_URL=https://your-project-ref.supabase.co

# Backend secret API key. Never use in frontend code.
SUPABASE_KEY=replace-with-your-supabase-secret-key

# Claude API (Content area)
ANTHROPIC_API_KEY=your-api-key-here
CONTENT_WRITER_MODEL=claude-sonnet-5-5
CONTENT_REVIEWER_MODEL=claude-opus-5-5
CONTENT_WRITER_EFFORT=low