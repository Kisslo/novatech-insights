# Template for local environment configuration.
# Copy to .env and replace the placeholders with actual values.
# Never include real API keys, passwords, or customer data.

# Supabase API connection.
# Project base URL, without /rest/v1.
SUPABASE_URL=https://your-project-ref.supabase.co

# Backend secret API key. Never use in frontend code.
SUPABASE_KEY=replace-with-your-supabase-secret-key

# Claude API (Content area)
ANTHROPIC_API_KEY=your-api-key-here
CONTENT_WRITER_MODEL=claude-sonnet-5-5
CONTENT_REVIEWER_MODEL=claude-opus-5-5
CONTENT_WRITER_EFFORT=low

# Topic labels and top-N list (src/label_topics.py, issue #27).
# Supabase views that the script reads ranked topics from (read only).
TOPICS_OVERVIEW_VIEW=topic_overview
TOPICS_ARTICLES_VIEW=topic_top_articles

# Saving labels with label_topics.py --save (issue #42).
# Table that gets label, why_relevant_sv and llm_relevance.
TOPICS_TABLE=topics

# Telegram API for n8n (src/telegram_api.py, issue #42).
# Long random key that n8n sends in the X-API-Key header (at least 32 characters).
# Create one with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_API_KEY=replace-with-a-long-random-key
# Where the API reads topics: fixture (tests/fixtures/sample_topics.json) or supabase.
TELEGRAM_SOURCE=fixture